# Gateway
PORT=20129
HOST=0.0.0.0
UPSTREAM_BASE_URL=http://127.0.0.1:20128
UPSTREAM_TIMEOUT_MS=180000
MEMORY_MODEL=mmf/mimo-auto
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_MODEL=SIMI-FREE
MEMORY_EXTRACTION_TIMEOUT_MS=15000
MEMORY_EXTRACTION_MIN_CONFIDENCE=0.80
MEMORY_EXTRACTION_QUEUE_LIMIT=100
MEMORY_EXTRACTION_CONCURRENCY=2

# Codex routing policy defaults. Keep Combo IDs stable; manage model members
# and fallback order in 9Router.
CODEX_COMBO_PREMIUM=
CODEX_COMBO_FREE=
CODEX_COMBO_TEST=SIMI-GEMINI
# Preferred server-to-server Combo API (requires the 9Router extension).
# Same token on 9Router: LTN_COMBO_API_TOKEN. Never distribute to clients.
# URL is restricted to loopback; no public endpoint or redirects allowed.
NINEROUTER_COMBO_API_URL=
NINEROUTER_COMBO_API_TOKEN=
# Legacy server-only dashboard session cookie for GET /api/combos.
# Needed only when 9Router protects its local management API. Never distribute to users.
NINEROUTER_DASHBOARD_COOKIE=
CODEX_DEFAULT_POLICY=limited_daily
# combo_members: all accounts select models inside their assigned combo,
# including accounts with an older explicit modelSelection=combo.
CODEX_MODEL_SELECTION=combo
CODEX_DEFAULT_PREMIUM_LIMIT=3
CODEX_USAGE_TIMEZONE=Asia/Ho_Chi_Minh
CODEX_USAGE_FILE=./data/codex-usage.json
CODEX_USAGE_RESERVATION_TTL_MS=300000
CODEX_USAGE_LOCK_TIMEOUT_MS=5000
CODEX_USAGE_LOCK_STALE_MS=120000

# Paths
TEAMS_FILE=./config/teams.json
LTN_USERS_CONFIG_FILE=./config/users.json
LTN_LEGACY_TEAM_KEYS_ENABLED=false
LTN_USERS_LOCK_TIMEOUT_MS=5000
LTN_USERS_LOCK_STALE_MS=120000
MEMORY_DIR=./memory
USER_MEMORY_ENABLED=true
USER_MEMORY_AUTO_UPDATE=true
USER_MEMORY_AUTO_UPDATE_MIN_CONFIDENCE=0.90
TEAM_MEMORY_ENABLED=true
TEAM_MEMORY_AUTO_UPDATE=true
COMPANY_MEMORY_ENABLED=true
COMPANY_MEMORY_AUTO_UPDATE=true
MEMORY_REVIEW_QUEUE_ENABLED=true
MEMORY_REVIEW_QUEUE_FILE=./data/memory-review-queue.jsonl
MEMORY_AUDIT_FILE=./data/memory-audit.jsonl
MEMORY_SYNC_OUTBOX_FILE=./data/memory-sync-outbox.jsonl
MEMORY_BACKUP_DIR=./data/memory-backups
USER_ANALYTICS_ENABLED=true
USER_ANALYTICS_RETENTION_DAYS=90
USER_ANALYTICS_FILE=./data/user-analytics.json
USER_USAGE_FILE=./data/user-usage.json

# Limits
MAX_BODY_BYTES=4000000
MAX_CAPABILITY_BODY_BYTES=32000000
MAX_CONTEXT_CHARS=24000
# Keep only recent images and compact huge tool text before forwarding /v1/responses.
RESPONSES_MAX_IMAGES=4
RESPONSES_MAX_TEXT_CHARS=200000
MAX_CAPTURE_BYTES=8000000
BROWSER_PAGE_MAX_CHARS=300000
BROWSER_PAGE_TTL_MS=120000
MAX_MEMORY_CHARS=16000
MEMORY_UPDATE_ENABLED=true
MEMORY_MAX_FILE_BYTES=262144
MEMORY_BACKUP_LIMIT=20

# Browser clients. Use exact public domain later instead of * when possible.
CORS_ALLOW_ORIGIN=*

# Optional admin endpoints. Generate a long random value.
ADMIN_TOKEN=

# LTN Admin Console
ADMIN_UI_ENABLED=false
ADMIN_UI_DIST_DIR=./admin-ui/dist
ADMIN_ALLOWED_HOSTS=admin-simi.simi.vn
ADMIN_ALLOWED_ORIGIN=https://admin-simi.simi.vn
ADMIN_CONFIG_FILE=./config/admins.json
ADMIN_AUDIT_FILE=./data/admin-audit.jsonl
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
ADMIN_CSRF_TTL_SECONDS=1800
ADMIN_RATE_LIMIT_READ_PER_MINUTE=120
ADMIN_RATE_LIMIT_WRITE_PER_MINUTE=30
ADMIN_RATE_LIMIT_KEY_ACTION_PER_HOUR=20

# OneDrive: off | local | graph
ONEDRIVE_MODE=off

# Mode local: OneDrive desktop sync folder on this Mac
# Example:
# ONEDRIVE_LOCAL_DIR=/Users/simi/Library/CloudStorage/OneDrive-SimiGO/LTN-AI-Memory
ONEDRIVE_LOCAL_DIR=

# Mode graph: Microsoft Graph app-only
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER=LTN-AI-Memory

# Auto-update for employee machines (skills/tools)
# false = pause every client update immediately (kill switch)
SIMI_AUTO_UPDATE_ENABLED=true
# Optional short note shown in the update notification
SIMI_RELEASE_NOTE=
# Latest update report per device (versions only)
DEVICE_UPDATES_FILE=./data/device-updates.json

# Sảnh online cho app Văn Phòng AI (ai đang online, nhân vật, nhắn tin giữa nhân viên)
# false = tắt Sảnh ngay lập tức (app hiện "Sảnh đang tắt")
LOBBY_ENABLED=true
# Hồ sơ nhân vật + lịch sử tin nhắn (JSONL theo phòng)
LOBBY_DATA_DIR=./data/lobby
# Số ngày giữ tin nhắn; tin cũ hơn tự xóa khi phòng được nạp lại
LOBBY_RETENTION_DAYS=30
LOBBY_MAX_MESSAGE_CHARS=2000
# Bản phát hành app Văn Phòng AI (trang tải /install/vanphong + tự cập nhật trên máy nhân viên)
# Đăng bản mới: node scripts/publish-vanphong.mjs <thư-mục-build>
VANPHONG_RELEASE_DIR=./data/releases/vanphong
# Sảnh đọc lại latest.json bao lâu một lần để báo ngay cho app khi có bản mới (mili giây)
LOBBY_RELEASE_CHECK_MS=30000
# Tự lấy bản app mới từ GitHub Release (repo app có GitHub Actions build 3 hệ điều hành) – token chỉ đọc, KHÔNG commit
# VANPHONG_GITHUB_REPO=LTN29/SIMI_VANPHONGAI
# VANPHONG_GITHUB_TOKEN=
# VANPHONG_GITHUB_POLL_MINUTES=5
