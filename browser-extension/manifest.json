{
  "manifest_version": 3,
  "name": "SIMI Browser Bridge",
  "version": "1.0.0",
  "description": "Gửi nội dung hiển thị của tab Chrome đã được người dùng cho phép tới LTN Gateway.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:20130/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "SIMI Browser Bridge",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
