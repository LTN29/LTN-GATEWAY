{
  "name": "ltn-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible team memory gateway for LTN in front of 9Router",
  "scripts": {
    "start": "node src/server.mjs",
    "check": "node --check src/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "register-team": "node scripts/register-team.mjs",
    "register-public-chatbot": "node scripts/register-public-chatbot.mjs",
    "sync-all": "node scripts/sync-all.mjs",
    "admin:dev": "npm --prefix admin-ui run dev",
    "admin:build": "npm --prefix admin-ui run build",
    "admin:test": "npm --prefix admin-ui run test",
    "admin:typecheck": "npm --prefix admin-ui run typecheck",
    "admin:lint": "npm --prefix admin-ui run lint"
  },
  "engines": {
    "node": ">=20"
  }
}
